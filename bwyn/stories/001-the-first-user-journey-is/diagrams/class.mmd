classDiagram
  direction LR

  class RegistrationController:::component {
    <<Component>>
    +showRegistrationForm() ModelAndView
    +register(request: RegistrationRequest) ResponseEntity
  }

  class RegistrationRequest:::entity {
    <<Entity>>
    +name: String
    +surname: String
    +age: Integer
  }

  class RegistrationService:::component {
    <<Interface>>
    +createAccount(request: RegistrationRequest) void
  }

  class RegistrationServiceImpl:::component {
    <<Component>>
    +createAccount(request: RegistrationRequest) void
  }

  class Account:::entity {
    <<Entity>>
    +id: Long
    +name: String
    +surname: String
    +age: Integer
  }

  class AccountRepository:::component {
    <<Interface>>
    +save(account: Account) Account
  }

  RegistrationController --> RegistrationService : Delegates account creation
  RegistrationController ..> RegistrationRequest : Receives and validates
  RegistrationServiceImpl ..|> RegistrationService : Implements
  RegistrationServiceImpl --> AccountRepository : Saves new account
  RegistrationServiceImpl ..> Account : Creates

  classDef component fill:#85BBF0,stroke:#5D82A8,color:#000000
  classDef entity fill:#438DD5,stroke:#3C7FC0,color:#ffffff
  classDef external fill:#999999,stroke:#6B6B6B,color:#ffffff
