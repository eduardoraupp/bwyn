sequenceDiagram
  actor user as "Team Member<br/>[Person]"
  box rgba(17,104,189,0.12) bwyn (Software System boundary)
    participant costsPanel as "CostsPanel<br/>[Component: React]"
    participant costsVM as "CostsViewModel<br/>[Component: TypeScript]"
    participant usageEndpoint as "GET /api/projects/{id}/usage<br/>[Component: Spring MVC]"
    participant queryHandler as "UsageByProviderUseCase<br/>[Component: Spring]"
    participant usageRepo as "Usage Repository<br/>[Component: Spring Data JPA]"
  end
  user->>costsPanel: Opens Settings > Costs
  costsPanel->>costsVM: Initialises and calls refresh
  costsVM->>usageEndpoint: GET /api/projects/{projectId}/usage
  usageEndpoint->>queryHandler: Queries usage grouped by provider
  queryHandler->>usageRepo: Reads per-provider token counts
  usageRepo-->>queryHandler: Returns usage records
  queryHandler-->>usageEndpoint: Returns ordered provider list
  usageEndpoint-->>costsVM: Returns provider usage response
  costsVM-->>costsPanel: Exposes per-provider view state
  costsPanel-->>user: Renders one block per provider
  alt count cannot be read
    usageEndpoint-->>costsVM: Returns error
    costsVM-->>costsPanel: Exposes error state
    costsPanel-->>user: Shows "The count could not be read right now"
  end
