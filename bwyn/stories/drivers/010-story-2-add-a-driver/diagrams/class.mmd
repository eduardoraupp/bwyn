classDiagram
direction LR

class AddDriverDialog:::component {
    <<Component>>
    +projectId: string
    +onClose() void
    +onDriverAdded(identity: string) void
}

class AddDriverViewModel:::component {
    <<Component>>
    +name: string
    +description: string
    +isAddEnabled: boolean
    +validationMessage: string
    +isDirty: boolean
    +setName(value: string) void
    +setDescription(value: string) void
    +addDriver() Promise~void~
    +applyProposal(text: string) void
}

class AddDriverUseCase:::component {
    <<Interface>>
    +execute(command: AddDriverCommand) Promise~AddDriverResult~
}

class AddDriverCommandHandler:::component {
    <<Component>>
    +execute(command: AddDriverCommand) Promise~AddDriverResult~
}

class Driver:::entity {
    <<Entity>>
    +identity: DriverIdentity
    +name: string
    +description: string
}

class DriverIdentity:::entity {
    <<Entity>>
    +value: string
    +deriveFrom(name: string, takenIdentities: string[]) DriverIdentity
}

class DriverRepositoryPort:::component {
    <<Interface>>
    +save(driver: Driver) Promise~void~
    +findAllIdentities(projectId: string) Promise~string[]~
}

class ImproveWithAI:::component {
    <<Component>>
    +projectId: string
    +currentText: string
    +noun: string
    +quickActions: string[]
    +systemInstructions: string
    +onApplyProposal(text: string) void
}

class useImproveWithAI:::component {
    <<Component>>
    +conversationState: ConversationState
    +send(instruction: string) void
    +stop() void
    +retry() void
}

AddDriverDialog --> AddDriverViewModel : Delegates state to
AddDriverDialog --> ImproveWithAI : Mounts with driver props
