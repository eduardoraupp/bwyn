sequenceDiagram
  actor lead as "Project Lead<br/>[Person]"
  box rgba(17,104,189,0.12) bwyn (Software System boundary)
    participant form as "Project Creation Form<br/>[Component: React]"
    participant vm as "CreateProjectViewModel<br/>[Component: TypeScript]"
    participant uc as "CreateProjectUseCase<br/>[Component: TypeScript]"
    participant ctrl as "ProjectController<br/>[Component: Spring MVC]"
    participant handler as "CreateProjectHandler<br/>[Component: Spring Boot]"
    participant repo as "ProjectPersistenceAdapter<br/>[Component: Spring Data JPA]"
  end
  participant db as "PostgreSQL<br/>[External Software System]"

  lead->>form: Submits name and description
  form->>vm: Calls createProject(name, description)
  vm->>uc: Executes create-project use case
  uc->>ctrl: POST /api/projects
  ctrl->>handler: Dispatches CreateProjectCommand
  handler->>repo: Saves project via port
  repo->>db: Inserts project row
  db-->>repo: Confirms insert
  repo-->>handler: Returns saved project
  handler-->>ctrl: Returns created project id
  ctrl-->>uc: 201 Created
  uc-->>vm: Returns success result
  vm-->>form: Updates state with confirmation
  form-->>lead: Redirects to landing page with confirmation message

  alt Name is blank
    lead->>form: Submits with empty name
    form->>vm: Calls createProject("", description)
    vm-->>form: Returns validation error
    form-->>lead: Shows inline validation error
  end
